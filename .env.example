# Copy this file to .env. Docker Compose reads .env from the repository root.

EUREKA_USERNAME=root
EUREKA_PASSWORD=toor123
FRONTEND_URL=http://localhost:3000

AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=zango_auth
AUTH_DB_USERNAME=zango
AUTH_DB_PASSWORD=zango
AUTH_DB_SCHEMA=public

JWT_PRIVATE_KEY_PATH=./gateway-service/keys/private.pem
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=zango
JWT_PUBLIC_KEY_PATH=./gateway-service/keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_KEY_ID=zango-auth-rs256-1
REFRESH_TOKEN_TTL=24h
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT_WINDOW=15m
