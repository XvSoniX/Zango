# Copy this file to .env. Docker Compose reads .env from the repository root.
# Sample values are for local development only. Production must set
# SPRING_PROFILES_ACTIVE=prod, EUREKA_SERVER_URL, EUREKA_USERNAME, EUREKA_PASSWORD,
# each service's DB username and password, JWT key paths, and the Grafana admin password.
# Do not commit .env. Private keys (*.pem) are gitignored.

EUREKA_USERNAME=root
EUREKA_PASSWORD=toor123
FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev

# Service ports. Compose also passes DISCOVERY_PORT into the discovery container.
DISCOVERY_PORT=8761
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
ADMIN_SERVICE_PORT=8083
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# For local processes, set EUREKA_SERVER_URL to your discovery URL when needed.
# Compose constructs its own internal URL from EUREKA_USERNAME, EUREKA_PASSWORD,
# and DISCOVERY_PORT; it does not use a host EUREKA_SERVER_URL override.
# EUREKA_SERVER_URL=http://root:toor123@localhost:8761/eureka/

# The gateway connect timeout is milliseconds; response timeout accepts durations.
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=5s

AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=nextminds_auth
AUTH_DB_USERNAME=nextminds
AUTH_DB_PASSWORD=nextminds
AUTH_DB_SCHEMA=public

USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=nextminds_user
USER_DB_USERNAME=nextminds
USER_DB_PASSWORD=nextminds
USER_DB_SCHEMA=public

JWT_PRIVATE_KEY_PATH=./gateway-service/keys/private.pem
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=nextminds
JWT_PUBLIC_KEY_PATH=./gateway-service/keys/public.pem
# Compose mounts these host files at /run/secrets; *_KEY_PATH is for local processes.
JWT_PRIVATE_KEY_FILE=./gateway-service/keys/private.pem
JWT_PUBLIC_KEY_FILE=./gateway-service/keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_KEY_ID=nextminds-auth-rs256-1
REFRESH_TOKEN_TTL=24h
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT_WINDOW=15m

# Local-process DB address. Compose uses its internal admin-db:5432 instead.
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=5432
ADMIN_DB_NAME=nextminds_admin
ADMIN_DB_USERNAME=nextminds
ADMIN_DB_PASSWORD=nextminds
ADMIN_DB_SCHEMA=public

# The Auth URL host is a Eureka service ID resolved by the load balancer.
ADMIN_AUTH_BASE_URL=http://AUTH-SERVICE
ADMIN_AUTH_CONNECT_TIMEOUT=1s
ADMIN_AUTH_RESPONSE_TIMEOUT=3s
ADMIN_AUDIT_STALE_AFTER=1h
ADMIN_AUDIT_MONITOR_INITIAL_DELAY=1m
ADMIN_AUDIT_MONITOR_INTERVAL=5m
# Optional: defaults to DEBUG in dev and INFO in stage/prod.
# ADMIN_LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=nextminds
GRAFANA_ADMIN_PASSWORD=replace-with-a-secret
