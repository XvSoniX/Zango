# Application
APP_ENV=dev
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://zango:zango@localhost:5432/zango_assessment
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Security & JWT Token Verification (RS256 matching Zango auth-service)
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=zango
JWT_ALGORITHM=RS256

# Netflix Eureka Service Discovery
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://root:toor123@discovery-service:8761/eureka/
EUREKA_APP_NAME=ASSESSMENT-SERVICE
EUREKA_INSTANCE_HOST=assessment-service
EUREKA_INSTANCE_PORT=8000
EUREKA_RENEWAL_INTERVAL_SECS=30
EUREKA_DURATION_SECS=90

# Assessment Engine Defaults
PROFILE_CODE=TECHNICAL_TALENT_V1
MIN_QUESTIONS=10
MAX_QUESTIONS=20
SESSION_TIMEOUT_SECONDS=2700
DEFAULT_MIN_AGE=10
DEFAULT_MAX_AGE=18
ALGORITHM_VERSION=1.0.0-baseline
QUESTION_BANK_VERSION=1.0.0
