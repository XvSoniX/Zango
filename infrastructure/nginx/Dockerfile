FROM nginx:alpine

ENV GATEWAY_PORT=8080 \
    FRONTEND_HOST=frontend \
    FRONTEND_PORT=3000 \
    NGINX_PROXY_CONNECT_TIMEOUT=3s \
    NGINX_PROXY_READ_TIMEOUT=60s \
    NGINX_PROXY_SEND_TIMEOUT=60s \
    NGINX_CLIENT_MAX_BODY_SIZE=0 \
    NGINX_ENVSUBST_FILTER="^(GATEWAY_PORT|FRONTEND_HOST|FRONTEND_PORT|NGINX_PROXY_CONNECT_TIMEOUT|NGINX_PROXY_READ_TIMEOUT|NGINX_PROXY_SEND_TIMEOUT|NGINX_CLIENT_MAX_BODY_SIZE)$"

COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/default.conf /etc/nginx/templates/default.conf.template
